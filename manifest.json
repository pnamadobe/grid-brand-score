{
  "manifest_version": 3,
  "name": "AEM Grid Brand Score",
  "version": "0.4.0",
  "description": "Shows xdm:score as a colour-banded badge on AEM Assets view grid cards, with xdm:brandScoreNotes on hover.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AEM Grid Brand Score — options",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://experience.adobe.com/*",
    "https://*.adobeaemcloud.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.adobe.com/*", "https://*.adobeaemcloud.com/*"],
      "js": ["src/page-hook.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://*.adobe.com/*", "https://*.adobeaemcloud.com/*"],
      "js": ["src/ranked.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_page": "options.html"
}
